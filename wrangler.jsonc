{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repoman",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-app"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
